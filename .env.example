ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here
ELEVENLABS_API_KEY=your_elevenlabs_key_here
ELEVENLABS_VOICE_ID=bFEu7NSVZzHAtQPj0F9R
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
ELEVENLABS_STABILITY=0.4
ELEVENLABS_SIMILARITY_BOOST=0.8
ELEVENLABS_STYLE=0.3
ELEVENLABS_SPEED=0.88
ELEVENLABS_SPEAKER_BOOST=true

# Direct (game mic) speak path: stream the LLM straight into ElevenLabs so Godfrey
# starts talking before the reply is finished. Saves roughly 1.5s per turn.
# Set to 0 to go back to waiting for the whole reply before any audio is sent.
GODFREY_PIPELINE_LLM_TTS=1

# Attach the source documents on the Unreal/exhibition speak path. On by default, since
# without them Godfrey answers from the system prompt alone. Set to false if the retrieval
# round-trip costs more latency than the extra grounding is worth.
GODFREY_STREAM_PCM_INCLUDE_DOCUMENTS=true

ADMIN_PASSWORD=change_me
ADMIN_SESSION_SECRET=change_me
SESSION_SECRET=change_me
# How long the visitor can pause before STT treats the turn as finished (ms).
# 550 cut people off mid-question. 1500 waits for a real end-of-sentence gap.
GODFREY_UNREAL_STT_SILENCE_MS=1500
GODFREY_UNREAL_STT_THRESHOLD=0.50
# Display-room visitors are not headset-close. near_field strips their voice.
GODFREY_UNREAL_STT_NOISE_REDUCTION=far_field
